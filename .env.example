# --dry-run 利用時は NOTION_* 未設定でも可（送信予定 JSON の data_source_id はダミーになる）

# Notion API キー
# 取得先: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion データベース ID
# データベースURLの末尾32文字: https://www.notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion data source ID（省略可）
# 省略時はデータベースから自動取得。データベースに data source が複数ある場合のみ指定する
# 取得先: Notion のデータベース設定 →「データソースを管理」→ ID をコピー
# NOTION_DATA_SOURCE_ID=

# 税率（省略時は 1.10）
# 例: 1.10 → 10%、1.08 → 8%
TAX_RATE=1.10
